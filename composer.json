{
    "name": "novosga/reports-bundle",
    "license": "MIT",
    "type": "symfony-bundle",
    "autoload": {
        "psr-4": {
            "Novosga\\ReportsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Novosga\\ReportsBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "doctrine/orm": "^3.2",
        "novosga/core": "2.3.x-dev",
        "symfony/framework-bundle": "7.4.*",
        "symfony/form": "7.4.*",
        "twig/twig": "^2.12|^3.0",
        "symfony/translation": "7.4.*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpdoc-parser": "^2.3.2",
        "phpunit/phpunit": "^11.5.55",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.3-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
